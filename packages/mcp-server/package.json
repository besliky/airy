  },
  "dependencies": {
    "@airy-office/docx-engine": "*",
    "@airy-office/file-parse": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jszip": "^3.10.1",
    "zod": "^4.6.1"
