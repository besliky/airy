{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      // resolve workspace types from this checkout's sources: in a git worktree
      // node_modules is a symlink into the main checkout, so bare specifiers
      // would typecheck against the other checkout's (possibly stale) types
      "@airy-office/docx-engine": ["../../packages/docx-engine/src/index.ts"],
      "@airy-office/font-metrics": ["../../packages/font-metrics/src/index.ts"],
      "@airy-office/electron-utils": ["../../packages/electron-utils/src/index.ts"],
      "@airy-office/ai-provider": ["../../packages/ai-provider/src/index.ts"],
      "@airy-office/i18n": ["../../packages/i18n/src/index.ts"],
      "@airy-office/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "tests", "electron.vite.config.ts", "vitest.config.ts"]
}
